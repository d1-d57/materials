"""Листок кружка 7И, 6.10 «Раскраски и разрезания». Фигуры — из issled/dannye_6-10*.json
(те же, что проверил issled/proverka_6-10.py). Преамбула и макросы \\zad, \\pole* — из listok_29-09_konstruktivy.tex.
Запуск: python3 sborka_listka_06-10.py → listok_06-10_raskraski.tex"""
import json
from pathlib import Path
from tikz_kletki import grid, polys
HERE = Path(__file__).parent
D = json.load(open(HERE / "issled/dannye_6-10.json")); D2 = json.load(open(HERE / "issled/dannye_6-10_v2.json"))
T4 = [(0,0),(0,1),(0,2),(1,1)]; UG3 = [(0,0),(1,0),(1,1)]
pre = (HERE / "listok_29-09_konstruktivy.tex").read_text(encoding="utf-8")
pre = pre[:pre.index("% ЛИСТОК КРУЖКА 7И, 29.09")].replace("\\usepackage{multirow}", "\\usepackage{multirow}\n\\usepackage{tikz}")
row = lambda *pics: "\\par\\vspace{3pt}" + "\\hspace{8pt}".join(pics)

Z = [
 ("", r"\poleB{а}{б}", r"Из шахматной доски $8\times8$ вырезали две угловые клетки. Можно ли разрезать оставшуюся часть на доминошки $1\times2$, если вырезали \textbf{(а)}~два угла одной стороны; \textbf{(б)}~два противоположных угла?"),
 ("", r"\poleA", r"Раскрасьте клетки квадрата $4\times4$ в чёрный и белый цвета так, чтобы у каждой чёрной клетки было ровно три белых соседа, а у каждой белой~--- ровно один чёрный сосед (соседи~--- клетки с общей стороной)."
   + row(grid(4,4), grid(4,4), grid(4,4))),
 ("", r"\poleA", r"Придумайте фигуру из клеток, которую можно вырезать из клетчатой бумаги одним куском и в которой при шахматной раскраске чёрных и белых клеток поровну, но которую нельзя разрезать на доминошки $1\times2$."
   + row(grid(4,9))),
 ("", r"\poleC{а}{б}{в}", r"Фишка ходит по доске $5\times5$ на соседнюю по стороне клетку. Можно ли обойти фишкой все клетки, побывав на каждой ровно один раз, если начать \textbf{(а)}~с угловой клетки; \textbf{(б)}~с клетки, соседней с угловой? \textbf{(в)}~С каких клеток можно начать такой обход?"
   + row(grid(5,5), grid(5,5))),
 ("", r"\poleB{а}{б}", r"Разрежьте по линиям сетки \textbf{(а)}~левую фигуру на три равные части; \textbf{(б)}~правую фигуру на четыре равные части."
   + row(grid(5,5, region=D2["fig3"]["F"]), "\\hspace{20pt}", grid(5,6, region=D2["fig4"]["F"]))),
 ("", r"\poleC{а}{б}{в}", r"Квадрат $4\times4$ разрезают по линиям сетки на две равные части. Способы, которые получаются друг из друга поворотом или отражением, считаются одинаковыми. \textbf{(а)}~Найдите три разных способа. \textbf{(б)}~Докажите, что линия разреза всегда проходит через центр квадрата. \textbf{(в)}~Найдите все способы."
   + row(*[grid(4,4, s=0.36) for _ in range(7)])),
 ("", r"\poleA", r"Разрежьте квадрат $6\times6$ на уголки из трёх клеток (рисунок) так, чтобы никакие два уголка не складывались в прямоугольник $2\times3$."
   + row(grid(2,2, region=UG3), "\\hspace{6pt}", grid(6,6))),
 ("", r"\poleC{а}{б}{в}", r"\textbf{(а)}~Докажите, что квадрат $3\times3$ нельзя разрезать на уголки из трёх клеток. \textbf{(б)}~Разрежьте на такие уголки квадрат $9\times9$. \textbf{(в)}~При каких $n$ квадрат $n\times n$ можно разрезать на уголки из трёх клеток?"
   + row(grid(9,9, s=0.38))),
 ("", r"\poleC{а}{б}{в}", r"Фигурка «Т» состоит из четырёх клеток (рисунок). \textbf{(а)}~Разрежьте квадрат $4\times4$ на такие фигурки. \textbf{(б)}~Докажите, что квадрат $6\times6$ разрезать на такие фигурки нельзя. \textbf{(в)}~При каких $n$ квадрат $n\times n$ можно разрезать на такие фигурки?"
   + row(grid(2,3, region=T4), "\\hspace{6pt}", grid(4,4))),
 (r"\star", r"\poleA", r"Из шахматной доски $8\times8$ вырезали две клетки разного цвета~--- любые. Докажите, что остаток всегда можно разрезать на доминошки."),
 (r"\star", r"\poleB{а}{б}", r"Квадрат $8\times8$ разрезали на четыре части, как на рисунке, и сложили из них прямоугольник $5\times13$. \textbf{(а)}~Найдите площадь квадрата и площадь прямоугольника. \textbf{(б)}~Откуда взялась лишняя клетка?"
   + row(polys(D["z13"]["sq"], 8, 8), "\\hspace{10pt}", polys(D["z13"]["rc"], 13, 5))),
]
shapka = r"""% ЛИСТОК КРУЖКА 7И, 6.10 — «Раскраски и разрезания». СОБРАН sborka_listka_06-10.py — руками не править.
% Состав финализирован владельцем 05.10 23:08 (SESSIYA.md); проверка: issled/proverka_6-10.py.
\newcommand{\shapka}{%
  \noindent{\LARGE\bfseries Раскраски и разрезания}%
  \hfill{\small Кружок, 7\,И\quad·\quad6 октября}%
  \vspace{4pt}\hrule\vspace{8pt}
  \noindent Фамилия, имя:\ \hrulefill\rule[-3mm]{0pt}{8mm}\par
  \vspace{2pt}
  \setcounter{zad}{0}}
\setlength{\mezhzad}{10pt}
"""
body = "\n\n".join(f"\\zad{{{zv}}}{{{pole}}}{{{txt}}}" for zv, pole, txt in Z)
(HERE / "listok_06-10_raskraski.tex").write_text(pre + shapka + "\n\\begin{document}\n\\shapka\n\n" + body + "\n\n\\end{document}\n", encoding="utf-8")
print("листок: задач", len(Z))
