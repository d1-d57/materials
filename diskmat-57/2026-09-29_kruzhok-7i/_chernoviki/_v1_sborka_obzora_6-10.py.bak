"""Обзор листка 6.10 «Раскраски и разрезания» для преподавателя: условия, картинки, решения,
подсказки, как придумывать разрезания. Картинки строятся из issled/dannye_6-10.json —
то есть из тех же решений, что проверил перебор (issled/proverka_6-10.py). Текст — словарь Z ниже.
Запуск: python3 issled/proverka_6-10.py (из issled/) и затем python3 sborka_obzora_6-10.py"""
import json, html
D = json.load(open("issled/dannye_6-10.json"))
S, PAD = 20, 5
NB = ((1,0),(-1,0),(0,1),(0,-1))

def svg(w, h, body, label, cls="fig"):
    return (f'<svg class="{cls}" viewBox="0 0 {w} {h}" width="{w}" role="img" '
            f'aria-label="{html.escape(label)}">{body}</svg>')

def grid(h, w, label, region=None, tiles=None, black=(), holes=(), path=None, closed=False,
         marks=(), start=None, s=S):
    region = set(map(tuple, region)) if region else {(r,c) for r in range(h) for c in range(w)}
    black = set(map(tuple, black)); holes = set(map(tuple, holes)); marks = set(map(tuple, marks))
    region -= holes
    X = lambda c: PAD + c*s; Y = lambda r: PAD + r*s
    piece, col = {}, {}
    if tiles:
        for i, t in enumerate(tiles):
            for c in t: piece[tuple(c)] = i
        for i, t in enumerate(tiles):   # жадная раскраска кусков в 4 оттенка
            used = {col.get(piece.get((r+a, c+b))) for r, c in map(tuple, t) for a, b in NB} - {None}
            col[i] = next(k for k in range(4) if k not in used)
    b = []
    for (r, c) in sorted(region):
        cls = "c-blk" if (r, c) in black else (f"c-p{col[piece[(r,c)]]}" if (r, c) in piece else "c-cell")
        b.append(f'<rect class="{cls}" x="{X(c)}" y="{Y(r)}" width="{s}" height="{s}"/>')
    for (r, c) in sorted(holes):
        b.append(f'<rect class="c-hole" x="{X(c)+2}" y="{Y(r)+2}" width="{s-4}" height="{s-4}"/>')
    for (r, c) in sorted(marks):
        b.append(f'<circle class="g-mark" cx="{X(c)+s/2}" cy="{Y(r)+s/2}" r="{s*0.22}"/>')
    seg = []
    for (r, c) in region:   # толстая линия — граница фигуры или разрез между кусками
        for (a, bb, x1, y1, x2, y2) in ((-1,0,c,r,c+1,r), (1,0,c,r+1,c+1,r+1), (0,-1,c,r,c,r+1), (0,1,c+1,r,c+1,r+1)):
            n = (r+a, c+bb)
            if n not in region or (tiles and piece.get(n) != piece.get((r, c))):
                seg.append(f'M{X(x1)} {Y(y1)}H{X(x2)}V{Y(y2)}' if y1 == y2 else f'M{X(x1)} {Y(y1)}V{Y(y2)}')
    b.append(f'<path class="g-cut" d="{"".join(seg)}"/>')
    if path:
        pts = " ".join(f"{X(c)+s/2},{Y(r)+s/2}" for r, c in path)
        tag = "polygon" if closed else "polyline"
        b.append(f'<{tag} class="g-path" points="{pts}"/>')
        r0, c0 = (start or path[0])
        b.append(f'<circle class="g-start" cx="{X(c0)+s/2}" cy="{Y(r0)+s/2}" r="{s*0.2}"/>')
    return svg(2*PAD + w*s, 2*PAD + h*s, "".join(b), label)

def poly_fig(polys, W, H, label, gap=None, u=19):
    X = lambda x: PAD + x*u; Y = lambda y: PAD + (H - y)*u
    b = [f'<path class="g-grid" d="' + "".join(f"M{X(i)} {Y(0)}V{Y(H)}" for i in range(W+1)) +
         "".join(f"M{X(0)} {Y(j)}H{X(W)}" for j in range(H+1)) + '"/>']
    for k, (name, P) in enumerate(polys.items()):
        pts = " ".join(f"{X(x)},{Y(y)}" for x, y in P)
        b.append(f'<polygon class="c-p{k%4} g-piece" points="{pts}"/>')
    if gap:
        b.append('<polygon class="g-gap" points="' + " ".join(f"{X(x)},{Y(y)}" for x, y in gap) + '"/>')
    return svg(2*PAD + W*u, 2*PAD + H*u, "".join(b), label)

def fig(svg_, cap=""):
    c = f"<figcaption>{cap}</figcaption>" if cap else ""
    return f"<figure>{svg_}{c}</figure>"

blk = lambda n: [(r, c) for r in range(n) for c in range(n) if (r + c) % 2 == 0]
UG = [(r,c) for r in range(4) for c in range(4) if not (r < 2 and c > 1)]
T4 = [(0,0),(0,1),(0,2),(1,1)]

F = {}   # картинки к условию (u) и к решению (r)
F["1u"] = [fig(grid(4,4,"пустой квадрат 4 на 4"))]
F["1r"] = [fig(grid(4,4,"способ разрезания 4 на 4 на две равные части", tiles=[A, [(r,c) for r in range(4) for c in range(4) if [r,c] not in A]]), "") for A in D["z1"]]
F["2r"] = [fig(grid(8,8,"доска 8 на 8 без двух углов одной стороны, разрезанная на доминошки", tiles=D["z2a"], holes=[(0,0),(0,7)]), "(а) верхняя строка — три доминошки, ниже — по четыре в строке"),
           fig(grid(8,8,"шахматная доска без двух противоположных углов", black=blk(8), holes=[(0,0),(7,7)]), "(б) оба вырезанных угла одного цвета: осталось 30 одного цвета и 32 другого")]
F["3u"] = [fig(grid(4,4,"уголок из трёх квадратов два на два", region=UG))]
F["3r"] = [fig(grid(4,4,"уголок, разрезанный на три квадрата", region=UG, tiles=D["z3a"]), "(а)"),
           fig(grid(4,4,"уголок, разрезанный на четыре маленьких уголка", region=UG, tiles=D["z3b"]), "(б) каждая часть — тот же уголок, только меньше")]
F["4r"] = [fig(grid(5,5,"доска 5 на 5 без центра, разрезанная по кольцам", tiles=D["z4a"], holes=[(2,2)]), "(а) режем по двум кольцам"),
           fig(grid(5,5,"доска 5 на 5 без угла: строка и столбики", tiles=D["z4v"], holes=[(0,0)]), "(в) n = 5: строка лёжа, остальное стоя")]
F["5u"] = [fig(grid(4,4,"пустой квадрат 4 на 4"))]
F["5r"] = [fig(grid(4,4,"ответ: четыре чёрные клетки ходом коня", black=D["z5"]), "единственный ответ с точностью до отражения")]
F["6r"] = [fig(grid(5,5,"змейка из угла", black=blk(5), path=D["z6"]), "(а) змейка из угла"),
           fig(grid(5,5,"клетки, с которых можно начать обход", black=blk(5), marks=D["z6map"]), "(в) все 13 клеток цвета угла, и только они")] + \
          [fig(grid(5,5,"обход из клетки цвета угла", black=blk(5), path=p, s=14), cap) for p, cap in zip(D["z6reps"], ["(в) из середины стороны", "по диагонали от угла", "из центра"])]
F["7u"] = [fig(grid(7,7,"пустой квадрат 7 на 7", s=16))]
F["7r"] = [fig(grid(7,7,"лесенка: по три клетки в строке и столбце", black=D["z7"], s=16), "лесенка: каждая строка — сдвиг предыдущей")]
F["8r"] = [fig(grid(5,5,"шахматная раскраска 5 на 5", black=blk(5)), "13 клеток цвета угла и 12 другого")]
F["9u"] = [fig(grid(6,6,"пустой квадрат 6 на 6", s=17)), fig(grid(2,2,"уголок из трёх клеток", region=[(0,0),(1,0),(1,1)], s=17))]
F["9r"] = [fig(grid(6,6,"разрезание 6 на 6 на уголки без прямоугольников 2 на 3", tiles=D["z9"]), "«вертушка»: при повороте на 90° картинка переходит в себя")]
z10 = D["z10"]
F["10r"] = [fig(grid(5,5,"клетки, которые можно вырезать", black=blk(5), marks=D["z10map"]), "можно вырезать любую из 13 клеток цвета угла"),
            fig(grid(5,5,"змейка без одной клетки, разрезанная на доминошки", tiles=z10["tiles"], holes=[z10["cut"]]), "клетка вырезана из змейки — оба куска змейки чётной длины")]
F["11u"] = [fig(grid(2,3,"фигурка Т из четырёх клеток", region=T4, s=17))]
F["11r"] = [fig(grid(4,4,"квадрат 4 на 4 из четырёх фигурок Т", tiles=D["z11"]), "(а)"),
            fig(grid(4,6,"фигурки Т на шахматной доске", region=[(0,0),(0,1),(0,2),(1,1),(2,3),(2,4),(2,5),(3,4)], black=[x for x in blk(6) if x[0] < 4]), "(б) любая Т накрывает 1 или 3 чёрные клетки")]
cyc = [tuple(x) for x in D["z12"]["cycle"]]; cut = [tuple(x) for x in D["z12"]["cut"]]
i, j = sorted(cyc.index(x) for x in cut)
arcs = [cyc[i+1:j], cyc[j+1:] + cyc[:i]]
tiles12 = [[a[k], a[k+1]] for a in arcs for k in range(0, len(a), 2)]
F["12r"] = [fig(grid(8,8,"замкнутая змейка через все клетки доски", path=cyc, closed=True, black=blk(8), s=16), "замкнутая змейка через все 64 клетки"),
            fig(grid(8,8,"змейка без двух клеток разного цвета, разрезанная на доминошки", tiles=tiles12, holes=cut, s=16), "две вырезанные клетки рвут змейку на два куска чётной длины")]
F["13u"] = [fig(poly_fig(D["z13"]["sq"], 8, 8, "квадрат 8 на 8, разрезанный на два треугольника и две трапеции"), "квадрат 8 × 8"),
            fig(poly_fig(D["z13"]["rc"], 13, 5, "прямоугольник 5 на 13 из тех же четырёх частей"), "прямоугольник 5 × 13")]
F["13r"] = [fig(poly_fig(D["z13"]["rc"], 13, 5, "прямоугольник с выделенной щелью вдоль диагонали", gap=D["z13"]["gap"]), "щель вдоль «диагонали» — параллелограмм площади 1")]

