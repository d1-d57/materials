 dict(n="12★", t="s", sut="теорема Гомори", otv="всегда можно", sl="5",
  usl="Из шахматной доски 8×8 вырезали две клетки разного цвета — любые. Докажите, что остаток всегда можно разрезать на доминошки.",
  otvet="Доказательство.",
  resh="Пройдём доску замкнутой змейкой — путём через все 64 клетки, который возвращается в начало (рисунок). Цвета вдоль змейки чередуются. Вырежем чёрную и белую клетку: змейка распадётся на два куска. Каждый кусок начинается после одной вырезанной клетки и кончается перед другой, а между клетками разного цвета на чередующемся пути стоит чётное число клеток. Значит, оба куска чётной длины, и каждый режется на доминошки подряд. Если вырезанные клетки соседние на змейке, кусок один.",
  kak="Это обращение задачи 2(б): там «одного цвета — нельзя», здесь «разного — всегда можно». Мост — змейка из задачи 10: там открытая змейка и одна клетка, здесь замкнутая и две.",
  podsk=["Вспомни задачу 10: что там сделала змейка?", "Найди замкнутую змейку — путь через все клетки, который возвращается в начало.", "Что происходит со змейкой, когда вырезаешь две клетки? Какой длины получаются куски?"],
  spr="Сначала — нарисовать замкнутую змейку. Потом — почему оба куска чётные.",
  zach="Настоящая звезда: идея одна, но её надо увидеть. Новых знаний не нужно, только змейка из задачи 10.",
  prov="паросочетание: все 32 · 32 = 1024 пары «чёрная + белая» дают разрезаемый остаток; замкнутая змейка с рисунка проверена."),
 dict(n="13★", t="s", sut="парадокс 64 = 65", otv="щель вдоль диагонали", sl="4",
  usl="Квадрат 8×8 разрезали на четыре части, как на рисунке, и сложили из них прямоугольник 5×13. (а) Найдите площадь квадрата и площадь прямоугольника. (б) Откуда взялась лишняя клетка?",
  otvet="(а) 64 и 65. (б) Части не складываются в прямоугольник плотно: вдоль «диагонали» остаётся узкая щель площади 1.",
  resh="Наклоны у частей разные. Гипотенуза треугольника поднимается на 3 клетки за 8, а косая сторона трапеции — на 2 за 5. 3/8 меньше 2/5 (сравнить 3 · 5 = 15 и 2 · 8 = 16), поэтому «диагональ» прямоугольника — не прямая, а ломаная, и две ломаные, от нижних частей и от верхних, не совпадают. Между ними — узкий параллелограмм площади 1. Проверить можно и по клеткам: настоящая диагональ прямоугольника 5×13 не проходит через узел (8, 3), а угол треугольника стоит ровно в нём.",
  kak="", podsk=["Посчитай площади. Если они разные, где-то обман. Где?", "Прямая ли «диагональ» у прямоугольника? Через какие узлы сетки она проходит?", "Сравни наклоны: на сколько поднимается сторона треугольника за 8 клеток? А сторона трапеции за 5?"],
  spr="(а) — ответ за секунды; (б) — разговор: принимать «части не прилегают, щель вдоль диагонали» с любым доводом, почему наклоны разные.",
  zach="Парадокс в духе «неожиданной контрольной» из листка про рыцарей: картинка обманывает, а площадь нет. Для преподавателя: 3, 5, 8, 13 — числа Фибоначчи, и 5 · 13 − 8² = 1.",
  prov="точные дроби: площади частей в сумме 64, части прямоугольника совпадают с частями квадрата, щель — параллелограмм площади 1 (наклоны 3/8 и 2/5)."),
]

def chips(t): return "".join(f'<span class="chip chip-{c}">{TAG[c]}</span>' for c in t)
rows = "".join(f'<tr><td class="num">{z["n"]}</td><td>{z["sut"]}</td><td>{chips(z["t"])}</td><td>{z["otv"]}</td><td class="num">{z["sl"]}</td></tr>' for z in Z)
secs = []
for z in Z:
    k = z["n"].rstrip("★")
    fu = "".join(F.get(k + "u", []))
    fr = "".join(F.get(k + "r", []))
    item = lambda lab, val: f'<div class="item"><h4>{lab}</h4><div>{val.rstrip(".")}</div></div>' if val else ""
    pod = "<ol>" + "".join(f"<li>{p}</li>" for p in z["podsk"]) + "</ol>"
    secs.append(f'''<section class="zad" id="z{k}">
<header><span class="n">{z["n"]}</span>{chips(z["t"])}</header>
<div class="usl"><p>{z["usl"]}</p>{f'<div class="figs">{fu}</div>' if fu else ''}</div>
<div class="item otv"><h4>Ответ</h4><div>{z["otvet"].rstrip(".")}</div></div>
{f'<div class="figs">{fr}</div>' if fr else ''}
{item("Решение", z["resh"])}{item("Как придумать", z["kak"])}{item("Подсказки", pod)}
{item("Что спросить при сдаче", z["spr"])}{item("Зачем в листке", z["zach"])}
<p class="prov">{z["prov"].rstrip(".")}</p></section>''')

page = open("obzor_6-10_shablon.html").read().replace("{{ROWS}}", rows).replace("{{SECS}}", "\n".join(secs))
open("obzor_6-10_raskraski.html", "w").write(page)
print("готово: obzor_6-10_raskraski.html,", len(page), "байт")
