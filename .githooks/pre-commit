#!/bin/sh
# Гейт коммита. Ставится ОДИН раз: git config core.hooksPath .githooks
#
# Живёт в репо (не в .git/hooks/), поэтому приезжает с клоном и версионируется —
# в .git/hooks/ он был бы только на одной машине и молча исчез бы при переустановке.
#
# Правило: молчит, когда чисто. Шумит только по делу — иначе его отключат, и это
# будет конец затеи (RESHENIYA Р31).
#
# Обойти: git commit --no-verify. Это НЕ дыра. Закон KONSTITUCIYA §11 говорит
# «правило, которое можно нарушить МОЛЧА, будет нарушено» — а не «нарушить нельзя».
# --no-verify придётся напечатать руками, значит уже не молча.

# ── Гейт уроков: урок без ЦЕНЫ → ❌ ──
python3 _generator/tools/check_uroki.py || exit 1

# ── Гейт картотеки: один источник истины ──
# Пять ворот, каждые по УЖЕ случившейся поломке: карточка заведена мимо картотеки ·
# карточка не в индексе по роду · ссылка на несуществующий id · ссылка на
# несуществующую секцию рамы · `.md` в _studio/ не зарегистрирован в KARTA.md §6.
# `--staged` — судит ТОЛЬКО пути этого коммита и молчит, пока чисто: чужой долг не
# должен валить чужие коммиты, иначе гейт отключат (та же клауза, что у уроков).
# Форма `if`, а не `[ -f … ] && …`: у второй код возврата самой ПРОВЕРКИ становится
# кодом возврата хука, и отсутствие файла читалось бы как «гейт покраснел».
KARTOTEKA=teoriya-kategoriy/kartoteka/KARTA-OBLASTI.md
if [ -f "$KARTOTEKA" ]; then
    python3 _generator/tools/check_kartoteka.py "$KARTOTEKA" --staged || exit 1
fi

# ── Фикстура git_zona: только когда правят САМ инструмент коммита ──
# Гоняем не на каждый коммит, а ровно тогда, когда регрессия может вернуться:
# обе поломки 21.07 (свальный коммит из чужого индекса; новые файлы не доезжают)
# живут в одной функции. Прогон ~1 с, на одноразовом репо в /tmp — боевой индекс
# не трогается, лок не берётся.
if git diff --cached --name-only | grep -q '^_generator/tools/git_zona\.py$'; then
    echo "→ правится git_zona.py — гоню его фикстуру"
    # env -u — ВТОРОЙ слой защиты (первый внутри самой фикстуры). Хук отдаёт
    # дочерним процессам GIT_DIR/GIT_INDEX_FILE на БОЕВОЙ репо; без вычистки
    # фикстура коммитит не в /tmp, а сюда — 21.07 так и вышло.
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
        sh _generator/tools/fixtures/git_zona/PROGNAT.sh || {
        echo "❌ Фикстура git_zona КРАСНАЯ — коммит остановлен."
        echo "   Вернулась одна из поломок 21.07, стоивших 125 путей вне git."
        echo "   Разбор: _studio/zhurnal/2026-07-21_mat-kostyak/OTCHET-git-kommity.md"
        exit 1
    }
fi
