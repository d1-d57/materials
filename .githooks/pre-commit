#!/bin/sh
# Гейт коммита. Ставится ОДИН раз: git config core.hooksPath .githooks
#
# Живёт в репо (не в .git/hooks/), поэтому приезжает с клоном и версионируется —
# в .git/hooks/ он был бы только на одной машине и молча исчез бы при переустановке.
#
# Правило: молчит, когда чисто. Шумит только по делу — иначе его отключат, и это
# будет конец затеи (RESHENIYA Р31).
#
# Обойти: git commit --no-verify. Это НЕ дыра. Закон KONSTITUCIYA §11 говорит
# «правило, которое можно нарушить МОЛЧА, будет нарушено» — а не «нарушить нельзя».
# --no-verify придётся напечатать руками, значит уже не молча.

# ── Гейт уроков: урок без ЦЕНЫ → ❌ ──
python3 _generator/tools/check_uroki.py || exit 1

# ── Гейт маркера: заход/хэндофф без следа генератора → ❌ ──
# Стоит здесь, рядом с гейтом уроков: он тоже копеечный (staged-текст, без
# исполнения кода) и тоже про НОВЫЙ файл коммита, не про унаследованный долг.
# Заводился заходом `zapret-rukopisnyh` (2026-08-11): маркер `<!-- собран
# bootstrap_zahod.py -->` уже ставился генератором, но на его отсутствие не
# краснело ничто — эта строка и есть потребитель метки.
python3 _generator/tools/check_marker.py --staged || exit 1

# ── Гейт веса: тяжёлое не впускается в историю ──
# Стоит ЗДЕСЬ, потому что позже уже поздно: файл, попавший в коммит, остаётся в
# .git навсегда, и удаление следующим ходом веса не вернёт — историю переписывает
# только git-filter-repo, отдельной операцией с бэкапом и force-push на общий репо.
# Цена, по которой гейт заведён (замер 01.08): .git — 1026 МБ при 220 МБ работы,
# из них 286 МБ PDF и 258 МБ tar-снапшотов, то есть больше половины репозитория —
# это то, что сюда когда-то впустили. По расширениям такое не ловится: .gitignore
# уже знал про *.pdf, */snapshots/ и /*.zip, а мимо прошли .djvu (книга с другим
# расширением), .zip не в корне и .jsonl-логи прогонов. Порог — по весу.
python3 _generator/tools/check_ves.py --staged || exit 1

# ── Гейт картотеки: один источник истины ──
# Пять ворот, каждые по УЖЕ случившейся поломке: карточка заведена мимо картотеки ·
# карточка не в индексе по роду · ссылка на несуществующий id · ссылка на
# несуществующую секцию рамы · `.md` в _studio/ не зарегистрирован в KARTA.md §6.
# `--staged` — судит ТОЛЬКО пути этого коммита и молчит, пока чисто: чужой долг не
# должен валить чужие коммиты, иначе гейт отключат (та же клауза, что у уроков).
# Форма `if`, а не `[ -f … ] && …`: у второй код возврата самой ПРОВЕРКИ становится
# кодом возврата хука, и отсутствие файла читалось бы как «гейт покраснел».
KARTOTEKA=teoriya-kategoriy/kartoteka/KARTA-OBLASTI.md
if [ -f "$KARTOTEKA" ]; then
    python3 _generator/tools/check_kartoteka.py "$KARTOTEKA" --staged || exit 1
fi

# ── Фикстура git_zona: только когда правят САМ инструмент коммита ──
# Гоняем не на каждый коммит, а ровно тогда, когда регрессия может вернуться:
# обе поломки 21.07 (свальный коммит из чужого индекса; новые файлы не доезжают)
# живут в одной функции. Прогон ~1 с, на одноразовом репо в /tmp — боевой индекс
# не трогается, лок не берётся.
if git diff --cached --name-only | grep -q '^_generator/tools/git_zona\.py$'; then
    echo "→ правится git_zona.py — гоню его фикстуру"
    # env -u — ВТОРОЙ слой защиты (первый внутри самой фикстуры). Хук отдаёт
    # дочерним процессам GIT_DIR/GIT_INDEX_FILE на БОЕВОЙ репо; без вычистки
    # фикстура коммитит не в /tmp, а сюда — 21.07 так и вышло.
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
        sh _generator/tools/fixtures/git_zona/PROGNAT.sh || {
        echo "❌ Фикстура git_zona КРАСНАЯ — коммит остановлен."
        echo "   Вернулась одна из поломок 21.07, стоивших 125 путей вне git."
        echo "   Разбор: _studio/zhurnal/2026-07-21_mat-kostyak/OTCHET-git-kommity.md"
        exit 1
    }
fi

# ── Контракт инструмента: на КАЖДЫЙ правленый инструмент фабрики ──
# Три гейта выше лечили КОНКРЕТНЫЕ поломки. Этот лечит их ОБЩИЙ корень: лекарство
# каждый раз было прозой (канон, урок, заметка), а проза не переносится на
# следующий инструмент. Живое доказательство — блок прямо надо мной: он поднимает
# фикстуру git_zona только на правку git_zona.py, хотя ловушка 14 внутри неё
# сторожит и три bootstrap_*. У гейта триггер был уже его охвата.
# Здесь охват объявляет сама фикстура (`# TOOL-CONTRACT-COVERS:`), и хук читает
# его, а не догадывается. Разбор — _studio/docs/kak-delat/GIT-disciplina.md §5.
# Под контракт попадают и подпапки (`tools/lib/x.py` — такой же инструмент), и
# то, что исполняется у владельца рядом с инструментами: фикстуры и сами хуки.
# GIT_ZONA_REPO и TOOL_CONTRACT_HOME вычищаются наравне с GIT_*: обе
# переадресуют гейт на другой репозиторий или другой дом фикстур, то есть
# ВЫКЛЮЧАЮТ его — молча, а значит негодным способом (KONSTITUCIYA §11).
TOOLS_STAGED=$(git diff --cached --name-only \
    | grep -e '^_generator/tools/.*\.py$' -e '^_generator/tools/fixtures/.*\.sh$' -e '^\.githooks/')
if [ -n "$TOOLS_STAGED" ]; then
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
        -u GIT_ZONA_REPO -u TOOL_CONTRACT_HOME \
        python3 _generator/tools/check_tool_contract.py --staged || exit 1
fi

# Охват фикстур — по ВСЕМ staged-путям, не по шаблону выше. `TOOLS_STAGED» —
# фильтр статического AST-гейта над python-инструментами; он уже сузил список
# ДО вызова `--fixtures-for`, и объявленный охват (`skeleton/engine.js`,
# `build_deck.py`, `render.py` — не под `_generator/tools/`) никогда не
# срабатывал, хотя фикстура `dvizhok` честно его называла (найдено 30.07,
# `fixtures/dvizhok/PROGNAT.sh:6-14`). Шаблон гадал, чей путь «похож на
# инструмент»; теперь охват решает `check_tool_contract.py` по имени файла
# (`fixture_coverage()`), а хук просто спрашивает — не угадывает. Дороже это
# не делает: цена — число ФИКСТУР (десяток PROGNAT.sh шапок), а не число
# staged-путей.
ALL_STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$ALL_STAGED" ]; then
    COVERING=$(env -u GIT_ZONA_REPO -u TOOL_CONTRACT_HOME \
        python3 _generator/tools/check_tool_contract.py --fixtures-for $ALL_STAGED)
    # Фикстуру git_zona исключаем, когда её уже поднял блок в начале файла:
    # двойной прогон ничего не проверяет, а секунду отнимает.
    if echo "$ALL_STAGED" | grep -q '^_generator/tools/git_zona\.py$'; then
        COVERING=$(echo "$COVERING" | grep -v '/fixtures/git_zona/')
    fi
    for FIX in $COVERING; do
        echo "→ правленый путь входит в охват $FIX — гоню её"
        env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
            -u GIT_ZONA_REPO -u TOOL_CONTRACT_HOME \
            sh "$FIX" || {
            echo "❌ Фикстура $FIX КРАСНАЯ — коммит остановлен."
            echo "   Она объявила охват над правленым путём, и охват сработал."
            exit 1
        }
    done
fi

# ══════ Заход `instrument-podklyuchen` (2026-08-08): четыре гейта подключаются ══════
# сюда живыми точками вызова — до этого «подключён» значило «упомянут в markdown,
# сработает, если агент прочтёт и вспомнит» (владелец назвал механизм точно).
# Все четыре прогнаны на живом дереве ПЕРЕД подключением (замер захода, § ПЛАН):
# `gejt_illyustracij.py`/`graf_zavisimostej.py` — зелёные на всех живых лекциях,
# подключены без смягчения; `proverka_pomarok.py`/`check_lenta.py` — красные на
# унаследованном (13 из 82 иллюстраций, единственная живая лента) — судим ТОЛЬКО
# `--diff-filter=A` (новое обязано родиться чистым), тот же приём, которым уже
# лечит себя `check_tool_contract.py:added_lines()` и `check_kartoteka.py --staged`.

# ── Помарки иллюстраций: proverka_pomarok.py на НОВЫХ staged-иллюстрациях ──
ILL_NEW=$(git diff --cached --name-only --diff-filter=A \
    | grep -E '/src/(illustrations|chapters)/[^/]+\.(svg|html)$')
if [ -n "$ILL_NEW" ]; then
    ILL_TMP=$(mktemp -d)
    ILL_FILES=""
    for p in $ILL_NEW; do
        safe=$(echo "$p" | tr '/' '_')
        if git --no-optional-locks show ":$p" > "$ILL_TMP/$safe" 2>/dev/null
        then ILL_FILES="$ILL_FILES $ILL_TMP/$safe"
        fi
    done
    if [ -n "$ILL_FILES" ]; then
        python3 _illustracii/proverka_pomarok.py $ILL_FILES || {
            echo "❌ Помарки иллюстраций (proverka_pomarok.py) — новая иллюстрация"
            echo "   красная, коммит остановлен. Разбор — _illustracii/proverka_pomarok.py."
            rm -rf "$ILL_TMP"
            exit 1
        }
    fi
    rm -rf "$ILL_TMP"
fi

# ── Гейт заказа иллюстраций + граф зависимостей — на staged лекциях (ACM) ──
LEC_ROOTS=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '/(slajdy/[^/]+/slaid\.md|illustracii/[^/]+/zakaz\.md)$' \
    | sed -E 's#/(slajdy|illustracii)/.*$##' | sort -u)
for LEC in $LEC_ROOTS; do
    [ -d "$LEC" ] || continue
    python3 _generator/tools/gejt_illyustracij.py "$LEC" --tiho || {
        echo "❌ Гейт заказа иллюстраций (gejt_illyustracij.py) красный на «$LEC» —"
        echo "   коммит остановлен:"
        python3 _generator/tools/gejt_illyustracij.py "$LEC"
        exit 1
    }
    python3 _generator/tools/graf_zavisimostej.py "$LEC" || {
        echo "❌ Граф зависимостей (graf_zavisimostej.py) красный на «$LEC» — коммит остановлен."
        exit 1
    }
done

# ── Гейт формы ленты: check_lenta.py на НОВЫХ staged лентах ──
LENTA_NEW=$(git diff --cached --name-only --diff-filter=A | grep -E '/LENTA-[^/]+\.md$')
if [ -n "$LENTA_NEW" ]; then
    LENTA_TMP=$(mktemp -d)
    for p in $LENTA_NEW; do
        safe=$(echo "$p" | tr '/' '_')
        if git --no-optional-locks show ":$p" > "$LENTA_TMP/$safe" 2>/dev/null; then
            python3 _generator/tools/check_lenta.py "$LENTA_TMP/$safe" --tiho || {
                echo "❌ Гейт формы ленты (check_lenta.py) красный на новой «$p» —"
                echo "   коммит остановлен:"
                python3 _generator/tools/check_lenta.py "$LENTA_TMP/$safe"
                rm -rf "$LENTA_TMP"
                exit 1
            }
        fi
    done
    rm -rf "$LENTA_TMP"
fi
