% 4. Доказательства 
%--------------------------------------------------------

\renewenvironment{proof}[1][\proofname]{\par
	\pushQED{\qed}%
	\normalfont \topsep6\p@\@plus6\p@\relax
	\trivlist
	\item[\hskip\labelsep
	\itshape
	\(\mathord{\mdlgwhtsquare}\)]\ignorespaces
}{%
	\popQED\endtrivlist\@endpefalse
}
\renewcommand{\proofname}{\relax} % Переопределение названия доказательства
\renewcommand{\qedsymbol}{\ensuremath{\mathord{\mdlgblksquare}}} % Символ конца доказательства

%--------------------------------------------------------
% 5. Таблицы
%--------------------------------------------------------
\renewcommand{\arraystretch}{1.2} % Изменение вертикальных отступов 

% Новые типы колонок
\newcolumntype{2}{cc}
\newcolumntype{3}{ccc}
\newcolumntype{4}{cccc}
\newcolumntype{5}{ccccc}
\newcolumntype{6}{cccccc}
\newcolumntype{s}[1]{>{\centering\arraybackslash}m{#1}}

% Контейнеры для таблицы 
\newsavebox{\baseTable} 
\newsavebox{\colorfulTable} 

\newcommand{\DefineTable}[2]{%
  % #1 — Название таблицы
  % #2 — Стиль

    \NewDocumentEnvironment{#1}{m O{} +b}{%
          % ##1 — Тип строк    
          % ##2 — Ширина таблицы   
          % ##3 — Текст
          
      % Сохраняем таблицу в контейнеры
      \sbox{\baseTable}{% Обычная таблица (без цвета)
        \AuxiliaryFont
        \arrayrulecolor{black} % Убираем границы
        \color{OverlayText}
        \begin{tabular}{##1}
          ##3
        \end{tabular}
      }
      
      \sbox{\colorfulTable}{% Цветная таблица (без границ)
        \begingroup
        \AuxiliaryFont
        \rowcolors{1}{\pgfkeysvalueof{/style/#2/BaseColor}}{white} % Чередование цветов строк
        \color{white} % Установка цвета текста
        \arrayrulecolor{white} % Убираем границы
        \begin{tabular}{##1}
          ##3
        \end{tabular}
        \endgroup
      }
      
      % Вычисление параметров таблицы
      \newdimen\tablewidth \tablewidth=\dimexpr \wd\baseTable\relax % Ширина
      \newdimen\tableheight \tableheight=\dimexpr\ht\baseTable+\dp\baseTable\relax % Высота
      \def\resizewidth{\ifblank{##2}{\dimexpr\wd\baseTable\relax}{##2}} % Итоговая ширина 
      
      \resizebox{\resizewidth}{!}{%
        \begin{tcolorbox}[
          universalbox,
          width=\dimexpr\tablewidth\relax, % Ширина таблицы
          height=\tableheight, % Высота таблицы
          overlay unbroken and first = {
            \begin{scope}
              % Обрезаем углы
              \clip[rounded corners=\mycorners] ([xshift=1pt]frame.south west) rectangle ([xshift=-1pt]frame.north east);
              
              % Цветная таблица
              \node[anchor=center] at (frame.center) {\hbox to \dimexpr\tablewidth\relax{\hfill\raisebox{-0.5\tableheight}{\usebox{\colorfulTable}}\hfill}};
              
              % Заливка фона
              \path[fill=\pgfkeysvalueof{/style/#2/BaseColor}, opacity=0.1] (frame.south west) rectangle (frame.north east);
    
              % Нанесение текстуры
              \node[anchor=south west, opacity=0.2] at ([xshift=-0.15cm, yshift=-4pt]frame.south west) {
                \includegraphicsrounded[width=\tablewidth, height=\tableheight]{\pgfkeysvalueof{/style/#2/Texture}}};
              
              % Градиент сверху вниз
              \path[shading=axis, top color=\pgfkeysvalueof{/style/#2/BaseColor}, bottom color=white, opacity=0.1, rounded corners=\mycorners]
                (frame.north west) rectangle (frame.south east);
    
              % Обычная таблица с полноценным текстом
              \node[anchor=center] at (frame.center) {\hbox to \dimexpr\tablewidth\relax{\hfill\raisebox{-0.5\tableheight}{\usebox{\baseTable}}\hfill}};
            \end{scope}
            
            % Тонкая черная рамка вокруг блока
            \path[draw=Border, line width=\mylinewd, rounded corners=\mycorners]([xshift=1pt]frame.south west) rectangle ([xshift=-1pt]frame.north east);
          }
        ]
        \end{tcolorbox}
      }
      \par 
    }{}
}

\DefineTable{importanttable}{Accent}
\DefineTable{exampletable}{Complement}
\DefineTable{notetable}{Primary}


% Определение команды для вставки таблиц из папки tables
\renewcommand{\table}[1]{%
    \ifx#1\relax
    \else
        \input{tables/#1}
    \fi
}
%--------------------------------------------------------
% 6. Списки и термины 
%--------------------------------------------------------

\newcommand{\term}[1]{\textbf{#1}}

\colorlet{BulletColor}{black} 

\RenewDocumentEnvironment{itemize}{+b}{%
    \begin{enumerate}[%
        topsep=0.1\standardparskip,       % Отступ перед и после списка
        itemsep=0.2\standardparskip,     % Расстояние между элементами списка
        parsep=0pt,                       % Расстояние между абзацами внутри элемента списка
        partopsep=0pt,                    % Дополнительный отступ перед списком после разрыва страницы
        leftmargin=1cm,                   % Левый отступ
        labelsep=0.05cm,                  % Расстояние между меткой и текстом элемента
        align=left,                       % Выравнивание текста по левому краю метки
        label=\textcolor{BulletColor}{\large\textbullet}, % Формат метки
    ]%
    \small
    #1
    \end{enumerate}
}{}

