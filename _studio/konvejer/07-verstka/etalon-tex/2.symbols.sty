% 1. Множества 
% 1.1 Числовые множества и поля
\def\0{\varnothing} % Пустое множество
\def\N{\mathbb N} % Натуральные числа
\def\Z{\mathbb Z} % Целые числа
\def\Q{\mathbb Q} % Рациональные числа
\def\R{\mathbb R} % Действительные числа
\def\C{\mathbb C} % Комплексные числа
\def\F{\mathbb F} % Поле 

% 1.2 Операции на множествах 
\def\Pc{\mathcal{P}} % Множество всех подмножеств
\def\sm{\setminus} % Разность множеств

% 2. Операции с числами 
\renewcommand\Re{\mathrm{Re}\,} % Действительная часть
\renewcommand\Im{\mathrm{Im}\,} % Мнимая часть
\newcommand*{\divby}{\mathrel{\rotatebox{90}{$\hskip-1pt.{}.{}.$}}} % Делимость
\newcommand{\bigslant}[2]{{\raisebox{.2em}{$#1$}\left/\raisebox{-.2em}{$#2$}\right.}} % Длинная дробь
\renewcommand\le{\leqslant} % Менее или равно
\renewcommand\ge{\geqslant} % Более или равно


\newcommand{\dblcolon}{\mathtoolsdblcolon}
\newcommand{\coloneqq}{\mathtoolscoloneqq}
\newcommand{\Coloneqq}{\mathtoolsColoneqq}
\newcommand{\eqqcolon}{\mathtoolseqqcolon}


\NewDocumentCommand{\DrawYoungDiagram}{O{(0,0)} m}{%
% #1 - сдвиг
% #2 - разбиение в формате: {число1, число2, ...}
    \begin{scope}[shift={#1}]
        % Итерируемся по каждому ряду разбиения
        \foreach [count=\i from 1] \row in {#2} {
            \foreach \j in {1,...,\row} {
                % Рисуем ячейки для каждой строки
                \draw (\j-1, -\i+1) rectangle ++(1, -1);
            }
        }
    \end{scope}
}