% 4. Доказательства 
%--------------------------------------------------------

\renewenvironment{proof}[1][\proofname]{\par
	\pushQED{\qed}%
	\normalfont \topsep6\p@\@plus6\p@\relax
	\trivlist
	\item[\hskip\labelsep
	\itshape
	\(\mathord{\mdlgwhtsquare}\)]\ignorespaces
}{%
	\popQED\endtrivlist\@endpefalse
}
\renewcommand{\proofname}{\relax} % Переопределение названия доказательства
\renewcommand{\qedsymbol}{\ensuremath{\mathord{\mdlgblksquare}}} % Символ конца доказательства
